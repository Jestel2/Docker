[Unit]
Description=Synchronize the VPN forwarded port with authenticated qBittorrent
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/opt/docker-stacks/arr-stack/config/gluetun/forwarded_port

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/docker-stacks/arr-stack/scripts/arr-maintenance.py port-sync
TimeoutStartSec=60
UMask=0077
